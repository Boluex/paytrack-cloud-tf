# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all sensitive variables files
*.tfvars.auth
*.tfvars.local
*.auth.tfvars
*.local.tfvars
*local*.tfvars

# Ignore transient CLI files
.terraform.tfstate.lock.info

# Ignore Lambda zip packaging build directory
**/.build/

# Local credentials and generated files
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
.terraform/
*.tfplan
tfplan
*.pem
*.key
__pycache__/
.pytest_cache/
venv/
.venv/
node_modules/
dist/
.build/
secrets.env
secrets.yaml
